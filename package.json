{
  "name": "sms-academy-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API máy chủ của SMS Academy (Node.js + Express + PostgreSQL)",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.8",
    "@types/express": "^5.0.6",
    "@types/node": "22.18.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.2"
  }
}
